{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BridgePad Desktop",
  "version": "0.1.0",
  "identifier": "dev.jonalakas.bridgepad.desktop",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "BridgePad Desktop",
        "width": 780,
        "height": 680,
        "minWidth": 620,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
